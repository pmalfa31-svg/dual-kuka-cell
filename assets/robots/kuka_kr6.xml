<mujoco model="kuka_kr6">
  <default>
    <joint damping="1.5" frictionloss="0.5" armature="0.1"/>
    <geom contype="1" conaffinity="1" material="mat_robot_base"/>
    <position kp="100" kv="10"/>
  </default>

  <!-- STRUTTURA MECCANICA (6-DOF Serial Chain) -->
  <worldbody>
    <body name="kuka_base" pos="0 0 0">
      <geom name="base_geom" type="cylinder" size="0.14 0.08" pos="0 0 0.08"/>
      
      <!-- GIUNTO 1: Rotazione Asse Z (Yaw: +-170 deg) -->
      <body name="link_1" pos="0 0 0.16">
        <joint name="joint_1" type="hinge" axis="0 0 1" range="-2.96 2.96"/>
        <geom name="link_1_geom" type="cylinder" size="0.1 0.1" pos="0 0 0.1"/>
        
        <!-- GIUNTO 2: Spalla Asse Y (Pitch: -190 / +45 deg) -->
        <body name="link_2" pos="0.05 0 0.2">
          <joint name="joint_2" type="hinge" axis="0 1 0" range="-3.31 0.78"/>
          <geom name="link_2_geom" type="capsule" fromto="0 0 0 0 0 0.4" size="0.07"/>
          
          <!-- GIUNTO 3: Gomito Asse Y (Pitch: -120 / +156 deg) -->
          <body name="link_3" pos="0 0 0.4">
            <joint name="joint_3" type="hinge" axis="0 1 0" range="-2.09 2.72"/>
            <geom name="link_3_geom" type="capsule" fromto="0 0 0 0.35 0 0" size="0.06"/>
            
            <!-- GIUNTO 4: Avambraccio Roll Asse X (+-185 deg) -->
            <body name="link_4" pos="0.35 0 0">
              <joint name="joint_4" type="hinge" axis="1 0 0" range="-3.22 3.22"/>
              <geom name="link_4_geom" type="capsule" fromto="0 0 0 0.1 0 0" size="0.05"/>
              
              <!-- GIUNTO 5: Polso Pitch Asse Y (+-120 deg) -->
              <body name="link_5" pos="0.1 0 0">
                <joint name="joint_5" type="hinge" axis="0 1 0" range="-2.09 2.09"/>
                <geom name="link_5_geom" type="cylinder" size="0.04 0.04" zaxis="0 1 0"/>
                
                <!-- GIUNTO 6: Flangia Roll Asse X (+-350 deg) + END-EFFECTOR -->
                <body name="link_6" pos="0.05 0 0">
                  <joint name="joint_6" type="hinge" axis="1 0 0" range="-6.1 6.1"/>
                  <geom name="flange_geom" type="cylinder" size="0.035 0.01" zaxis="1 0 0" material="mat_conveyor"/>
                  
                  <!-- Ventosa Industriale (Suction Gripper Tool) -->
                  <body name="vacuum_gripper" pos="0.04 0 0">
                    <geom name="vacuum_geom" type="cylinder" size="0.04 0.02" zaxis="1 0 0" rgba="0.2 0.7 0.2 1"/>
                    <site name="suction_site" pos="0.02 0 0" size="0.01" rgba="1 0 0 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
