<mujoco model="dual_kuka_cell">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.1 0.1 0.2" width="512" height="512"/>
    <texture name="grid_floor" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.7 0.7 0.7" width="512" height="512"/>
    <material name="mat_floor" texture="grid_floor" texrepeat="20 20" reflectance="0.1"/>
    
    <material name="mat_conveyor" rgba="0.15 0.15 0.15 1" specular="0.4" shininess="0.3"/>
    <material name="mat_chute" rgba="0.4 0.45 0.55 1" specular="0.9" shininess="0.8"/>
    <material name="mat_rail" rgba="0.7 0.7 0.75 1" specular="0.8" shininess="0.6"/>
    <material name="mat_pallet" rgba="0.6 0.4 0.2 1" specular="0.1"/>
    <material name="mat_robot_base" rgba="0.9 0.4 0.05 1" specular="0.7" shininess="0.5"/>
    <material name="mat_package" rgba="0.85 0.2 0.2 1" specular="0.2"/>
  </asset>

  <!-- CLASSIFICATORE DEI DEFAULT: Isola i robot dal corpo libero del pacco -->
  <default>
    <geom contype="1" conaffinity="1"/>
    <default class="robot">
      <joint damping="1.5" frictionloss="0.5" armature="0.1"/>
      <position kp="250" kv="25"/>
    </default>
  </default>

  <worldbody>
    <light directional="true" pos="0 0 4" dir="0 0 -1" castshadow="true" diffuse="0.8 0.8 0.8"/>
    <light directional="false" pos="2 2 3" diffuse="0.4 0.4 0.4"/>
    <light directional="false" pos="-2 -2 3" diffuse="0.4 0.4 0.4"/>

    <geom name="floor" type="plane" size="5 5 0.1" material="mat_floor"/>

    <!-- NASTRO OVALE PIANO -->
    <geom name="conveyor_straight_1" type="box" pos="0 0.6 0.4" size="1.2 0.2 0.05" material="mat_conveyor"/>
    <geom name="conveyor_straight_2" type="box" pos="0 -0.6 0.4" size="1.2 0.2 0.05" material="mat_conveyor"/>
    <geom name="conveyor_curve_east" type="cylinder" pos="1.2 0 0.4" size="0.8 0.05" material="mat_conveyor"/>
    <geom name="conveyor_curve_west" type="cylinder" pos="-1.2 0 0.4" size="0.8 0.05" material="mat_conveyor"/>

    <!-- SPONDE TRATTI RETTILINEI -->
    <geom name="rail_north_outer" type="box" pos="0 0.81 0.48" size="1.2 0.01 0.04" material="mat_rail"/>
    <geom name="rail_north_inner" type="box" pos="0 0.39 0.48" size="1.2 0.01 0.04" material="mat_rail"/>
    <geom name="rail_south_outer" type="box" pos="0 -0.81 0.48" size="1.2 0.01 0.04" material="mat_rail"/>
    <geom name="rail_south_inner" type="box" pos="0 -0.39 0.48" size="1.2 0.01 0.04" material="mat_rail"/>

    <!-- SPONDE CURVA OVEST -->
    <geom name="rail_w_out_1" type="box" pos="-1.51 0.75 0.48" size="0.25 0.01 0.04" euler="0 0 0.39" material="mat_rail"/>
    <geom name="rail_w_out_2" type="box" pos="-1.86 0.46 0.48" size="0.25 0.01 0.04" euler="0 0 0.98" material="mat_rail"/>
    <geom name="rail_w_out_3" type="box" pos="-2.01 0.0 0.48" size="0.25 0.01 0.04" euler="0 0 1.5708" material="mat_rail"/>
    <geom name="rail_w_out_4" type="box" pos="-1.86 -0.46 0.48" size="0.25 0.01 0.04" euler="0 0 -0.98" material="mat_rail"/>
    <geom name="rail_w_out_5" type="box" pos="-1.51 -0.75 0.48" size="0.25 0.01 0.04" euler="0 0 -0.39" material="mat_rail"/>

    <geom name="rail_w_in_1" type="box" pos="-1.35 0.36 0.48" size="0.14 0.01 0.04" euler="0 0 0.5" material="mat_rail"/>
    <geom name="rail_w_in_2" type="box" pos="-1.59 0.0 0.48" size="0.14 0.01 0.04" euler="0 0 1.5708" material="mat_rail"/>
    <geom name="rail_w_in_3" type="box" pos="-1.35 -0.36 0.48" size="0.14 0.01 0.04" euler="0 0 -0.5" material="mat_rail"/>

    <!-- SPONDE CURVA EST -->
    <geom name="rail_e_out_1" type="box" pos="1.51 0.75 0.48" size="0.25 0.01 0.04" euler="0 0 -0.39" material="mat_rail"/>
    <geom name="rail_e_out_2" type="box" pos="1.86 0.46 0.48" size="0.25 0.01 0.04" euler="0 0 -0.98" material="mat_rail"/>
    <geom name="rail_e_out_3" type="box" pos="1.86 -0.46 0.48" size="0.25 0.01 0.04" euler="0 0 0.98" material="mat_rail"/>
    <geom name="rail_e_out_4" type="box" pos="1.51 -0.75 0.48" size="0.25 0.01 0.04" euler="0 0 0.39" material="mat_rail"/>

    <geom name="rail_e_in_1" type="box" pos="1.35 0.36 0.48" size="0.14 0.01 0.04" euler="0 0 -0.5" material="mat_rail"/>
    <geom name="rail_e_in_2" type="box" pos="1.59 0.0 0.48" size="0.14 0.01 0.04" euler="0 0 1.5708" material="mat_rail"/>
    <geom name="rail_e_in_3" type="box" pos="1.35 -0.36 0.48" size="0.14 0.01 0.04" euler="0 0 0.5" material="mat_rail"/>

    <!-- SCIVOLO A PENDENZA DOLCE E ARRETRATO (17 deg / -0.30 rad) -->
    <geom name="chute_ramp" type="box" pos="2.45 0 0.59" size="0.45 0.18 0.02" euler="0 -0.30 0" material="mat_chute" friction="0.02 0.005 0.0001"/>
    <geom name="chute_rail_left" type="box" pos="2.45 0.19 0.63" size="0.45 0.01 0.06" euler="0 -0.30 0" material="mat_rail" friction="0.02 0.005 0.0001"/>
    <geom name="chute_rail_right" type="box" pos="2.45 -0.19 0.63" size="0.45 0.01 0.06" euler="0 -0.30 0" material="mat_rail" friction="0.02 0.005 0.0001"/>
    <geom name="chute_leg" type="cylinder" pos="2.80 0 0.35" size="0.04 0.35" material="mat_conveyor" contype="0" conaffinity="0"/>

    <!-- PALLET STATIONS -->
    <geom name="pallet_1" type="box" pos="0.8 1.3 0.1" size="0.4 0.4 0.1" material="mat_pallet"/>
    <geom name="pallet_2" type="box" pos="-0.8 -1.3 0.1" size="0.4 0.4 0.1" material="mat_pallet"/>

    <!-- ROBOT 1 (Nord) -->
    <body name="r1_pedestal" pos="0 1.3 0" childclass="robot">
      <geom name="r1_ped_geom" type="cylinder" pos="0 0 0.25" size="0.2 0.25" material="mat_robot_base"/>
      <body name="r1_base" pos="0 0 0.5" euler="0 0 -1.5708">
        <geom name="r1_base_g" type="cylinder" size="0.14 0.08" pos="0 0 0.08" material="mat_robot_base"/>
        <body name="r1_link1" pos="0 0 0.16">
          <joint name="r1_j1" type="hinge" axis="0 0 1" range="-2.96 2.96"/>
          <geom name="r1_l1_g" type="cylinder" size="0.1 0.1" pos="0 0 0.1" material="mat_robot_base"/>
          <body name="r1_link2" pos="0.05 0 0.2">
            <joint name="r1_j2" type="hinge" axis="0 1 0" range="-3.31 0.78"/>
            <geom name="r1_l2_g" type="capsule" fromto="0 0 0 0 0 0.4" size="0.07" material="mat_robot_base"/>
            <body name="r1_link3" pos="0 0 0.4">
              <joint name="r1_j3" type="hinge" axis="0 1 0" range="-2.09 2.72"/>
              <geom name="r1_l3_g" type="capsule" fromto="0 0 0 0.35 0 0" size="0.06" material="mat_robot_base"/>
              <body name="r1_link4" pos="0.35 0 0">
                <joint name="r1_j4" type="hinge" axis="1 0 0" range="-3.22 3.22"/>
                <geom name="r1_l4_g" type="capsule" fromto="0 0 0 0.1 0 0" size="0.05" material="mat_robot_base"/>
                <body name="r1_link5" pos="0.1 0 0">
                  <joint name="r1_j5" type="hinge" axis="0 1 0" range="-2.09 2.09"/>
                  <geom name="r1_l5_g" type="cylinder" size="0.04 0.04" zaxis="0 1 0" material="mat_robot_base"/>
                  <body name="r1_link6" pos="0.05 0 0">
                    <joint name="r1_j6" type="hinge" axis="1 0 0" range="-6.1 6.1"/>
                    <geom name="r1_flange_g" type="cylinder" size="0.035 0.01" zaxis="1 0 0" material="mat_conveyor"/>
                    <body name="r1_gripper" pos="0.04 0 0">
                      <geom name="r1_vac_g" type="cylinder" size="0.04 0.02" zaxis="1 0 0" rgba="0.2 0.7 0.2 1"/>
                      <site name="r1_suction_site" pos="0.02 0 0" size="0.01" rgba="1 0 0 1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ROBOT 2 (Sud) -->
    <body name="r2_pedestal" pos="0 -1.3 0" childclass="robot">
      <geom name="r2_ped_geom" type="cylinder" pos="0 0 0.25" size="0.2 0.25" material="mat_robot_base"/>
      <body name="r2_base" pos="0 0 0.5" euler="0 0 1.5708">
        <geom name="r2_base_g" type="cylinder" size="0.14 0.08" pos="0 0 0.08" material="mat_robot_base"/>
        <body name="r2_link1" pos="0 0 0.16">
          <joint name="r2_j1" type="hinge" axis="0 0 1" range="-2.96 2.96"/>
          <geom name="r2_l1_g" type="cylinder" size="0.1 0.1" pos="0 0 0.1" material="mat_robot_base"/>
          <body name="r2_link2" pos="0.05 0 0.2">
            <joint name="r2_j2" type="hinge" axis="0 1 0" range="-3.31 0.78"/>
            <geom name="r2_l2_g" type="capsule" fromto="0 0 0 0 0 0.4" size="0.07" material="mat_robot_base"/>
            <body name="r2_link3" pos="0 0 0.4">
              <joint name="r2_j3" type="hinge" axis="0 1 0" range="-2.09 2.72"/>
              <geom name="r2_l3_g" type="capsule" fromto="0 0 0 0.35 0 0" size="0.06" material="mat_robot_base"/>
              <body name="r2_link4" pos="0.35 0 0">
                <joint name="r2_j4" type="hinge" axis="1 0 0" range="-3.22 3.22"/>
                <geom name="r2_l4_g" type="capsule" fromto="0 0 0 0.1 0 0" size="0.05" material="mat_robot_base"/>
                <body name="r2_link5" pos="0.1 0 0">
                  <joint name="r2_j5" type="hinge" axis="0 1 0" range="-2.09 2.09"/>
                  <geom name="r2_l5_g" type="cylinder" size="0.04 0.04" zaxis="0 1 0" material="mat_robot_base"/>
                  <body name="r2_link6" pos="0.05 0 0">
                    <joint name="r2_j6" type="hinge" axis="1 0 0" range="-6.1 6.1"/>
                    <geom name="r2_flange_g" type="cylinder" size="0.035 0.01" zaxis="1 0 0" material="mat_conveyor"/>
                    <body name="r2_gripper" pos="0.04 0 0">
                      <geom name="r2_vac_g" type="cylinder" size="0.04 0.02" zaxis="1 0 0" rgba="0.2 0.7 0.2 1"/>
                      <site name="r2_suction_site" pos="0.02 0 0" size="0.01" rgba="1 0 0 1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- PACCO TEST: Posizionato in cima alla nuova rampa a 17 gradi -->
    <body name="box_0" pos="2.78 0 0.73" euler="0 -0.30 0">
      <freejoint name="box_0_joint"/>
      <geom name="box_0_geom" type="box" size="0.1 0.1 0.05" mass="1.0" material="mat_package" friction="0.02 0.005 0.0001"/>
      <site name="box_0_site" pos="0 0 0" size="0.01"/>
    </body>
  </worldbody>

  <equality>
    <weld name="r1_weld" site1="r1_suction_site" site2="box_0_site" active="false"/>
    <weld name="r2_weld" site1="r2_suction_site" site2="box_0_site" active="false"/>
  </equality>

  <actuator>
    <position name="act_r1_j1" joint="r1_j1" ctrlrange="-2.96 2.96" class="robot"/>
    <position name="act_r1_j2" joint="r1_j2" ctrlrange="-3.31 0.78" class="robot"/>
    <position name="act_r1_j3" joint="r1_j3" ctrlrange="-2.09 2.72" class="robot"/>
    <position name="act_r1_j4" joint="r1_j4" ctrlrange="-3.22 3.22" class="robot"/>
    <position name="act_r1_j5" joint="r1_j5" ctrlrange="-2.09 2.09" class="robot"/>
    <position name="act_r1_j6" joint="r1_j6" ctrlrange="-6.1 6.1" class="robot"/>

    <position name="act_r2_j1" joint="r2_j1" ctrlrange="-2.96 2.96" class="robot"/>
    <position name="act_r2_j2" joint="r2_j2" ctrlrange="-3.31 0.78" class="robot"/>
    <position name="act_r2_j3" joint="r2_j3" ctrlrange="-2.09 2.72" class="robot"/>
    <position name="act_r2_j4" joint="r2_j4" ctrlrange="-3.22 3.22" class="robot"/>
    <position name="act_r2_j5" joint="r2_j5" ctrlrange="-2.09 2.09" class="robot"/>
    <position name="act_r2_j6" joint="r2_j6" ctrlrange="-6.1 6.1" class="robot"/>
  </actuator>
</mujoco>
